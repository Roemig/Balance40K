    <selectionEntryGroup name="Regimental Commendations" id="c3f5-2be4-b7c8-22ca" hidden="false">
      <constraints>
        <constraint id="0e5d-2d1e-ff5e-ca44" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="2"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Paragons of Drills Discipline" id="e3e5-5269-182e-3fdd" hidden="false" import="true" type="upgrade">
          <constraints>
