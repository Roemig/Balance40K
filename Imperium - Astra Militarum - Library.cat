          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When Steiner or Kage are attached to a squad, add 1 to any hit and wound rolls. These squads also gain the Deep Strike and Infiltrator abilities.</characteristic>
