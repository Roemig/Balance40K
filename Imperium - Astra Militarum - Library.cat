        <profile name="Summary Execution" id="8ddc-b1a4-b15b-5664" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle round, at the start of any phase, you can select one friendly ASTRA MILITARUM INFANTRY or ASTRA MILITARUM MOUNTED unit that is Battle-shocked and within 12&quot; of this model. If you do, one model in that unit is destroyed, and that unit is then no longer Battle-shocked.</characteristic>
          </characteristics>
        </profile>
        <profile name="Political Overwatch" id="a350-b497-752c-2d6b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While another Officer model is in the same unit as this model, you can re-roll Battle-shock tests taken for that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Orders" id="ee60-68e1-642d-9edc" hidden="false" typeId="3fc9-16d8-8670-c8e2" typeName="Orders">
          <characteristics>
            <characteristic name="Orders" typeId="36b-c3c9-245f-e97d">This unit can issue 1 Order to a **^^Regiment^^** unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
