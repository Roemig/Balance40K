          </characteristics>
        </profile>
        <profile name="Orders" id="a57d-2330-88aa-8a9b" hidden="false" typeId="3fc9-16d8-8670-c8e2" typeName="Orders">
          <characteristics>
            <characteristic name="Orders" typeId="36b-c3c9-245f-e97d">This **^^Officer^^** can issue 2 Order to **^^Platoon^^** units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Bloodhound" id="cd72-3f8c-d345-0e89" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the game, you must exchange the Platoon Commander of any Platoon Command Squad Unit with Captain Al&apos;rahem. When doing so, Captain Al&apos;rahem&apos;s Platoon Command Squad and any attached unit must start the game in Strategic Reserve, but may arrive from reserves during turn 1. If this is not possible, Captain Al&apos;rahem is destroyed.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Claw of the Desert Tiger" id="8f76-8353-6480-e7fe" hidden="false" import="true" type="upgrade">
