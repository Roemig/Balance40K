            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
          </characteristics>
        </profile>
        <profile name="Political Overwatch" id="ccec-db7f-8187-2ac" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While another **^^Officer^^** model is in the same unit as this model, you can re-roll Battle-shock tests taken for that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Officer" id="11a-efa7-7a1e-27e9" hidden="false" typeId="3fc9-16d8-8670-c8e2" typeName="Orders">
          <characteristics>
            <characteristic name="Orders" typeId="36b-c3c9-245f-e97d">This Officer can issue 1 Order to a Ogryn or Regiment unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
