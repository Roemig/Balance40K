      <profiles>
        <profile name="Desert Warrior" id="8ad9-8b60-242f-91e4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time a unit affected by Captain Al&apos;rahem&apos;s has shot, if it is not within Engagement Range of any enemy units, it can make a Normal move of up to D6&quot;.</characteristic>
          </characteristics>
        </profile>
        <profile name="Captain Al&apos;rahem" id="868b-3152-c311-4059" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6&quot;</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">3</characteristic>
            <characteristic name="SV" typeId="450-a17e-9d5e-29da">5+</characteristic>
