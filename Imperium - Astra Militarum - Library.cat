            <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="0"/>
            <cost name="Crusade: Experience" typeId="a623-fe74-1d33-cddf" value="0"/>
            <cost name="Crusade: Weapon Modifications" typeId="716d-91b7-d55a-1022" value="0"/>
            <cost name="Logistics Points" typeId="04b1-67f7-48cb-4f1f" value="0"/>
            <cost name="Commendation Points" typeId="46a1-6b58-ecdd-8087" value="0"/>
            <cost name="Commendation Points" typeId="e969-59de-fdb7-7c4e" value="8"/>
          </costs>
          <infoLinks>
            <infoLink name="Sustained Hits" id="b3fa-8c39-d361-12d7" hidden="false" targetId="1897-c22c-9597-12b1" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Paragons of Drills Discipline" id="f19f-3392-28d9-412a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a unit in your Crusade army is under the effects of the First Rank Fire! Second Rank Fire! Order, if that unit Remains Stationary, its Rapid Fire weapons have the **[SUSTAINED HITS 1]** ability.

In addition:

- While you have a surplus in Materiel, each time an **^^Artillery^^** unit from your Crusade army makes a ranged attack, re-roll a Hit roll of 1.
- While you have a deficiency in Tithe Pool, the cost to use the follow Requisitions is increased by 1RP: Increase Supply Limit; Repair Recuperate; Fresh Recruits.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Veteran Guerrillas" id="3552-4276-7810-5f34" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3cea-e2ec-2fc8-151e" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
            <cost name="Crusade Points" typeId="b03b-c239-15a5-da55" value="3"/>
            <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="0"/>
            <cost name="Crusade: Experience" typeId="a623-fe74-1d33-cddf" value="0"/>
            <cost name="Crusade: Weapon Modifications" typeId="716d-91b7-d55a-1022" value="0"/>
            <cost name="Logistics Points" typeId="04b1-67f7-48cb-4f1f" value="0"/>
            <cost name="Commendation Points" typeId="46a1-6b58-ecdd-8087" value="0"/>
            <cost name="Commendation Points" typeId="e969-59de-fdb7-7c4e" value="8"/>
          </costs>
          <profiles>
            <profile name="Veteran Guerrillas" id="bfff-9f42-5320-7f74" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a **^^Regiment^^** unit in your Crusade army is under the effects of the Fix Bayonets! Order, melee weapons equipped by models in that unit have the **[PRECISION]** ability.

In addition:

- While you have a surplus in Tithe Pool, **^^Regiment^^** units from your Crusade army gain 2XP from Battle Experience instead of just 1XP.
- While you have a deficiency in Morale, at the end of the battle, unless you are the victor, you do not receive a Requisition point for playing a battle.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Veteran Crew" id="93e7-b665-f415-2566" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7f58-9aa3-0e6d-60bc" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
            <cost name="Crusade Points" typeId="b03b-c239-15a5-da55" value="3"/>
            <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="0"/>
            <cost name="Crusade: Experience" typeId="a623-fe74-1d33-cddf" value="0"/>
            <cost name="Crusade: Weapon Modifications" typeId="716d-91b7-d55a-1022" value="0"/>
            <cost name="Logistics Points" typeId="04b1-67f7-48cb-4f1f" value="0"/>
